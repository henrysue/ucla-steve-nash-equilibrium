# Copy this file to .env and fill in your values.
# Never commit .env — it holds your Official Agent Key.

# Base URL of the AltruAgent control plane. This is the platform's real,
# deployed default; override it only if you're pointing at a local/dev
# instance of Agent_ACP's backend.
ALTRUAGENT_CONTROL_URL=https://api.altruagent-game.com

# Your Official Agent Key (eak_live_...), generated on the tournament
# dashboard's Agent Configuration page (https://platform.altruagent-game.com/tournament/dashboard).
# `python -m agent --tournament` uses it to play your tournament games,
# `python -m agent --match` your test matches (use both flags for both).
# Keep it secret; press Rotate key there if it ever leaks.
# Guide: https://platform.altruagent-game.com/tournament/agent-guide
ALTRUAGENT_OFFICIAL_AGENT_KEY=eak_live_your_key_here

# --- Model access for the VGC Draft strategist (agent/agent.py) --------------
# Set ONE of these. ANTHROPIC_API_KEY wins if both are present. With neither,
# the strategist still plays every phase from its own heuristics — weaker, but
# it never forfeits. Keys are only ever sent to their own vendor's API and are
# never printed or logged, and only while a game is being played.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Override the model id for whichever provider is selected above.
# Defaults: claude-sonnet-5 (Anthropic), gpt-4o-mini (OpenAI).
# Sonnet 5 is $2/$10 per MTok and runs roughly $0.40-0.80 a match. Opus 5 is
# $5/$25 and gives better payoff estimates; the equilibrium solving, opponent
# modelling and risk arithmetic are deterministic code and identical on both.
# VGC_MODEL=claude-opus-5

# Audit trail. Writes one pair of files per match into this directory:
#   <stamp>-<game>-<session>-seat<n>.md     human-readable, decision by decision
#   <stamp>-<game>-<session>-seat<n>.jsonl  one JSON record per decision
# Each record holds the model's own reasoning, the candidate lines, the payoff
# matrix, the Nash mix, the opponent-model posterior and cheese verdict, the
# action actually sent, and the attempts/seconds it cost - including when a
# fallback was played and why. Unset, the same trail still goes to stdout.
# The model's reasoning is private deliberation: it is written here and never
# sent to the platform's public reasoning_summary.
# VGC_LOG_DIR=./matchlogs

# The draft reference table. Defaults to the tournament format's own file,
# data/vgc_2025_reg_i_draft_doubles.csv (gen9vgc2025regi). Point this at a
# different table when the format rotates; renamed columns are tolerated.
# VGC_META_CSV=./data/vgc_2025_reg_i_draft_doubles.csv

# Only needed for examples/llm_agent.py, the generalist example that plays all
# three games (python -m agent --tournament --agent examples.llm_agent).
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Send each decision's one-line reasoning to the platform (public: spectators
# and possibly the opponent can read it) instead of "Move submitted.".
# Same as `python -m agent --show-reasoning`. The model's private thinking is
# never sent either way.
# VGC_PUBLIC_REASONING=1
